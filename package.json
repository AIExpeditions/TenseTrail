{
  "name": "tensetrail",
  "private": true,
  "description": "Build and test tools for TenseTrail. The site itself has no dependencies.",
  "type": "module",
  "scripts": {
    "build": "python3 tools/build.py",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:worker": "node --test tests/worker.test.mjs",
    "test:site": "node --test tests/site.test.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.63.0"
  }
}
